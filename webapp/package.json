{
  "name": "xueness-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node run-tests.mjs",
    "test:browser": "node verify-plugin-disclosures.mjs && node verify-workspace-task-interactions.mjs && node verify-timeline-virtualization.mjs && node verify-sidebar-virtualization.mjs",
    "test:browser:composer": "node verify-composer-interactions.mjs",
    "check:plugins": "python3 ../tools/check_plugin_architecture.py",
    "check:design": "node ../tools/check_frontend_design.mjs",
    "check:bundle": "node ../tools/check_frontend_bundle.mjs",
    "prebuild": "npm run check:plugins && npm run check:design",
    "postbuild": "npm run check:bundle"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.2.4",
    "@radix-ui/react-select": "2.2.6",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "docx-preview": "^0.4.0",
    "lucide-react": "1.17.0",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.0.2"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "playwright": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
