{
  "id": "remote",
  "name": "Remote",
  "description": "Explicitly approved remote operations and the local stdio app-server.",
  "apiVersion": 1,
  "version": "1.0.0",
  "defaultEnabled": false,
  "dependencies": [],
  "tools": [
    "remote_exec"
  ],
  "commands": [
    "remote",
    "app-server"
  ],
  "panels": [
    "remote"
  ],
  "resources": [],
  "capabilities": [],
  "httpFamilies": [
    "remote"
  ],
  "modules": [
    "app_server",
    "frame_replay",
    "handshake"
  ],
  "features": [
    {
      "id": "remote.app_server",
      "name": "stdio JSON-RPC app-server 入口",
      "nameEn": "Stdio JSON-RPC app-server entry point"
