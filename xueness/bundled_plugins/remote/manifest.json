    {
      "id": "remote.frame_replay",
      "name": "stdio 帧有界重放（实验，默认关闭）",
      "nameEn": "Bounded stdio frame replay (experimental, off by default)"
    },
    {
      "id": "remote.connections",
      "name": "命名 SSH 主机连接配置",
      "nameEn": "Named SSH host connection settings"
    },
    {
      "id": "remote.exec",
      "name": "明确批准的远程 argv 执行",
      "nameEn": "Explicitly approved remote argv execution"
    },
    {
      "id": "remote.handshake",
      "name": "远程执行握手与能力协商（实验，默认关闭）",
      "nameEn": "Remote execution handshake and capability check (experimental, off by default)"
    }
  ],
  "frontendModules": [
    "plugins/remote/index.tsx"
  ]
}
