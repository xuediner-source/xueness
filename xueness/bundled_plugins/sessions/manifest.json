{
  "id": "sessions",
  "name": "会话与聊天",
  "description": "CLI/Web 会话选择、管理、输入及聊天入口。",
  "version": "1.0.0",
  "apiVersion": 1,
  "defaultEnabled": true,
  "dependencies": [],
  "tools": [
    "read_session_context"
  ],
  "commands": [
    "new",
    "run",
    "chat",
    "list",
    "show",
    "journal",
    "answer",
    "sessions"
  ],
  "panels": [
    "chat"
  ],
  "resources": [],
  "capabilities": [],
  "httpFamilies": [
    "composer",
    "sessions",
    "sessions/*/model"
  ],
  "modules": [
    "cli",
    "cli_input",
    "cli_interrupt",
    "cli_tui",
    "composer_api",
    "completion_policy",
    "deltas",
    "events_cursor",
    "forking",
    "http_routes",
    "manual_compact",
    "model_switch",
    "operator_cli",
    "plan_mode",
    "queue",
    "session_management",
    "sessions_api",
    "tooling"
  ],
  "features": [
    {
      "id": "sessions.conversation",
      "name": "会话创建与 Agent 对话",
      "nameEn": "Sessions and agent conversations"
    },
    {
      "id": "sessions.plan_mode",
      "name": "计划权限模式（只读并先出计划）",
      "nameEn": "Plan permission mode (read-only, plan first)"
    },
    {
      "id": "sessions.management",
      "name": "选择、搜索、重命名、固定与归档",
      "nameEn": "Select, search, rename, pin and archive"
    },
    {
      "id": "sessions.history",
      "name": "历史导航与跨会话上下文检索",
      "nameEn": "History navigation and session context search"
    },
    {
      "id": "sessions.fork",
      "name": "闭合历史轮次分叉与来源链接",
      "nameEn": "Safe history forks and parent links"
    },
    {
      "id": "sessions.fork_from_checkpoint",
      "name": "从轮次检查点派生新会话",
      "nameEn": "Fork a session from a turn checkpoint"
    },
    {
      "id": "sessions.portable",
      "name": "脱敏导出、导入与恢复",
      "nameEn": "Redacted export, import and resume"
    },
    {
      "id": "sessions.streaming",
      "name": "文本、思考与工具调用增量流",
      "nameEn": "Text, reasoning and tool streams"
    },
    {
      "id": "sessions.composer",
      "name": "附件、上下文引用与会话输入",
      "nameEn": "Attachments, context mentions and input"
    },
    {
      "id": "sessions.message_queue",
      "name": "运行期间排队发送后续消息",
      "nameEn": "Queue follow-up messages during a run"
    },
    {
      "id": "sessions.tui",
      "name": "多行 CLI、全屏 TUI 与中断恢复",
      "nameEn": "Multiline CLI, fullscreen TUI and interruption"
    },
    {
      "id": "sessions.command_palette",
      "name": "命令面板搜索与键盘导航",
      "nameEn": "Command palette search and keyboard navigation"
    },
    {
      "id": "sessions.timeline_follow",
      "name": "时间线跟随与回到底部",
      "nameEn": "Timeline following and return to bottom"
    },
    {
      "id": "sessions.start_page",
      "name": "空会话起始页快捷动作与最近会话",
      "nameEn": "Empty-session start page actions and recent sessions"
    },
    {
      "id": "sessions.manual_compact",
      "name": "手动压缩上下文（/compact 与说明）",
      "nameEn": "Manual context compaction (/compact with instructions)"
    },
    {
      "id": "sessions.tool_concurrency",
      "name": "依赖感知的工具并发调度",
      "nameEn": "Dependency-aware tool concurrency"
    },
    {
      "id": "sessions.runtime_model_switch",
      "name": "运行中切换模型与推理档位（/model、/effort）",
      "nameEn": "Switch model and reasoning level mid-run via /model and /effort"
    },
    {
      "id": "sessions.model_picker",
      "name": "模型选择分档、目录标签与详情卡",
      "nameEn": "Model picker presets, catalog tabs and detail card"
    },
    {
      "id": "sessions.events_cursor",
      "name": "会话事件增量游标拉取（实验，默认关闭）",
      "nameEn": "Incremental session event cursor polling (experimental, off by default)"
    }
  ],
  "frontendModules": [
    "plugins/sessions/XuenessComposerToolbar.tsx",
    "plugins/sessions/XuenessConversationHistoryRail.tsx",
    "plugins/sessions/XuenessRenameDialog.tsx",
    "plugins/sessions/XuenessTaskList.tsx",
    "plugins/sessions/XuenessTimeline.tsx",
    "plugins/sessions/XuenessWorkbenchView.tsx",
    "xuenessComposer.ts",
    "xuenessWorkbench.ts",
    "plugins/sessions/ForkSessionDialog.tsx",
    "plugins/sessions/index.ts",
    "plugins/sessions/composerCatalogLifecycle.ts",
    "plugins/sessions/ComposerWorkspaceSelect.tsx",
    "plugins/sessions/completionPresentation.ts",
    "plugins/sessions/SessionQueue.tsx",
    "plugins/sessions/CommandPalette.tsx",
    "plugins/sessions/ConversationTimelineViewport.tsx",
    "plugins/sessions/SessionPolling.ts",
    "plugins/sessions/XuenessStartPage.tsx",
    "plugins/sessions/permissionModes.ts",
    "plugins/sessions/TimelineVirtualWindow.ts#TimelineWindowModel",
    "plugins/sessions/TimelineVirtualWindow.ts#useTimelineVirtualWindow"
  ]
}
