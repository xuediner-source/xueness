{
  "id": "subagents",
  "name": "子代理",
  "description": "只读子任务、进度与协作取消。",
  "version": "1.0.0",
  "apiVersion": 1,
  "defaultEnabled": true,
  "dependencies": [
    "sessions",
    "files"
  ],
  "tools": [
    "task",
    "task_collect"
  ],
  "commands": [],
  "panels": [
    "capabilities",
    "subagents"
  ],
  "resources": [
    "subagents"
  ],
  "capabilities": [
    "network"
  ],
  "httpFamilies": [
    "sessions/*/tasks",
    "resources/subagents"
  ],
  "modules": [
    "coordinator",
    "tools",
    "runner",
    "subagents",
    "task_registry"
  ],
  "features": [
    {
      "id": "subagents.tasks",
      "name": "只读子任务与嵌套代理",
      "nameEn": "Read-only subtasks and nested agents"
    },
    {
      "id": "subagents.progress",
      "name": "子任务进度、结果与取消",
      "nameEn": "Subtask progress, results and cancellation"
    },
    {
      "id": "subagents.parallel_coordination",
      "name": "后台并发派发、主代理持续工作与结果收集",
      "nameEn": "Background delegation, parent progress and result collection"
    },
    {
      "id": "subagents.settings",
      "name": "子代理资源与能力配置",
      "nameEn": "Subagent resources and capability settings"
    },
    {
      "id": "subagents.sidepane",
      "name": "Web 端子代理运行态侧栏",
      "nameEn": "Web subagent runtime sidepane"
    }
  ],
  "frontendModules": [
    "plugins/subagents/SubagentSettings.tsx",
    "plugins/subagents/SubagentSidePane.tsx"
  ]
}
