{
  "id": "planning",
  "name": "计划与问答",
  "description": "会话 TODO 和等待用户回答工具。",
  "version": "1.0.0",
  "apiVersion": 1,
  "defaultEnabled": true,
  "dependencies": [],
  "tools": [
    "todo_read",
    "todo_write",
    "ask_user",
    "delivery_plan"
  ],
  "commands": [
    "goal"
  ],
  "panels": [],
  "resources": [],
  "capabilities": [],
  "httpFamilies": [
    "delivery",
    "sessions/*/goal"
  ],
  "modules": [
    "tooling",
    "delivery",
    "session_goal",
    "work_policy"
  ],
  "features": [
    {
      "id": "planning.todos",
      "name": "待办计划读取与更新",
      "nameEn": "Read and update task plans"
    },
    {
      "id": "planning.questions",
      "name": "提问、用户回答与继续",
      "nameEn": "Questions, user answers and continuation"
    },
    {
      "id": "planning.delivery",
      "name": "交付清单与内容完整性检查",
      "nameEn": "Delivery checklist and content completeness checks"
    },
    {
      "id": "planning.session_goal",
      "name": "会话目标设置、每轮注入与完成核验",
      "nameEn": "Session goals with per-request reminders and completion checks"
    },
    {
      "id": "planning.goal_editor",
      "name": "添加菜单会话目标创建与显式替换",
      "nameEn": "Add-menu goal creation and explicit replacement"
    },
    {
      "id": "planning.work_policy",
      "name": "任务拆解、持续执行与交付自查规则",
      "nameEn": "Task decomposition, persistent execution and delivery self-checks"
    }
  ],
  "frontendModules": [
    "plugins/planning/CompletionChecks.tsx",
    "plugins/planning/SessionGoal.tsx#SessionGoal",
    "plugins/planning/GoalEditorDialog.tsx"
  ]
}
