{
  "id": "network",
  "name": "网络工具",
  "description": "批准约束的公网 HTTPS 页面读取、网页搜索服务配置与 DNS 诊断。",
  "apiVersion": 1,
  "version": "1.0.0",
  "defaultEnabled": true,
  "dependencies": [],
  "tools": [
    "web_fetch",
    "web_search"
  ],
  "commands": [],
  "panels": [],
  "resources": [],
  "capabilities": [],
  "modules": [
    "search_settings",
    "search_model",
    "settings_api",
