{
  "name": "xueness-ts",
  "private": true,
  "version": "0.2.1",
  "description": "Xueness TypeScript backend workspace (strangler migration from the Python backend).",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "workspaces": [
    "packages/*",
    "plugins/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check:lines": "node scripts/check-max-lines.ts",
    "check:plugins": "node scripts/check-plugins.ts",
    "check": "npm run check:lines && npm run check:plugins && npm run typecheck",
    "serve": "node apps/server/src/main.ts",
    "build": "npm run typecheck && node scripts/build.ts",
    "serve:built": "node dist/apps/server/src/main.js --project-root .."
  },
  "devDependencies": {
    "@types/node": "~24.19.2",
    "typescript": "~5.9.3"
  }
}
