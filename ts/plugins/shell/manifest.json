{
  "apiVersion": 2,
  "id": "shell",
  "name": "命令执行",
  "description": "经审批的模型命令工具，含后台任务。",
  "version": "0.2.0",
  "defaultEnabled": true,
  "capabilities": {
    "exec": [
      "*"
    ],
    "fs": {
      "write": [
        "workspace",
        "state"
      ]
    }
  },
  "tools": [
    {
      "name": "exec",
      "gate": "exec",
      "mutating": true,
      "concurrencySafe": false
    },
    {
      "name": "exec_output",
      "gate": "planning",
      "mutating": false,
      "concurrencySafe": false
    },
    {
      "name": "exec_kill",
      "gate": "exec",
      "mutating": true,
      "concurrencySafe": false
    }
  ],
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "defaultTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000,
          "description": "Timeout when a call gives none."
        },
        "maxCaptureBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576,
          "description": "Output kept per stream; the rest goes to a file."
        },
        "scrubEnv": {
          "type": "boolean",
          "description": "Drop credential-looking environment variables."
        },
        "passEnv": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "maxItems": 64,
          "description": "Variables passed even when they look like credentials."
        },
        "backgroundTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000,
          "description": "Timeout of a background task when the call gives none."
        },
        "maxBackgroundTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "Background tasks that may run at once."
        },
        "shellMode": {
          "type": "string",
          "enum": [
            "system",
            "bash"
          ],
          "description": "Default system shell or explicit Bash/Git Bash."
        },
        "shellExecutable": {
          "type": "string",
          "description": "Optional Bash executable path for bash mode."
        },
        "captureInit": {
          "type": "boolean",
          "description": "Lazily snapshot Bash initialization after command authorization."
        },
        "startupScript": {
          "type": "string",
          "maxLength": 262144,
          "description": "Bash startup script sourced before each command."
        }
      },
      "additionalProperties": false
    },
    "default": {
      "defaultTimeoutMs": 120000,
      "maxCaptureBytes": 24576,
      "scrubEnv": true,
      "passEnv": [],
      "backgroundTimeoutMs": 1800000,
      "maxBackgroundTasks": 8,
      "shellMode": "system",
      "shellExecutable": "",
      "captureInit": false,
      "startupScript": ""
    }
  },
  "features": [
    {
      "id": "shell.exec",
      "name": "批准后的 argv 命令执行",
      "nameEn": "Approved argv command execution"
    },
    {
      "id": "shell.background",
      "name": "后台命令任务",
      "nameEn": "Background command tasks"
    },
    {
      "id": "shell.background_notifications",
      "name": "后台任务状态与完成通知",
      "nameEn": "Background task state and completion notices"
    },
    {
      "id": "shell.execution_adapter",
      "name": "通用命令调用适配",
      "nameEn": "Generic command invocation adapter"
    },
    {
      "id": "shell.bash_provider",
      "name": "Bash 与 Git Bash 选择",
      "nameEn": "Bash and Git Bash selection"
    },
    {
      "id": "shell.init_snapshot",
      "name": "授权后懒加载 Shell 初始化快照",
      "nameEn": "Lazy shell initialization snapshots after authorization"
    },
    {
      "id": "shell.startup_script",
      "name": "持久 Shell 启动脚本配置",
      "nameEn": "Persisted shell startup scripts"
    }
  ],
  "httpFamilies": [
    "shell/settings"
  ],
  "modules": [
    "shell_provider",
    "shell_snapshot",
    "startup_script",
    "config_api"
  ]
}
