{
  "apiVersion": 2,
  "id": "files",
  "name": "工作区文件",
  "description": "工作区文件工具：读取、列目录、glob、grep、写入、编辑与结构化补丁。",
  "version": "0.2.0",
  "defaultEnabled": true,
  "capabilities": {
    "fs": {
      "write": [
        "workspace"
      ]
    }
  },
  "tools": [
    {
      "name": "read",
      "gate": "read",
      "mutating": false,
      "concurrencySafe": true
    },
    {
      "name": "list",
      "gate": "list",
      "mutating": false,
      "concurrencySafe": true
    },
    {
      "name": "glob",
      "gate": "glob",
      "mutating": false,
      "concurrencySafe": true
    },
    {
      "name": "grep",
      "gate": "grep",
      "mutating": false,
      "concurrencySafe": true
    },
    {
      "name": "write",
      "gate": "write",
      "mutating": true,
      "concurrencySafe": false
    },
    {
      "name": "edit",
      "gate": "edit",
      "mutating": true,
      "concurrencySafe": false
    },
    {
      "name": "apply_patch",
      "gate": "edit",
      "mutating": true,
      "concurrencySafe": false
    }
  ],
  "features": [
    {
      "id": "files.read",
      "name": "文件列表、搜索与分页读取",
      "nameEn": "File listing, search and paged reading"
    },
    {
      "id": "files.mutations",
      "name": "批准后的文件写入与编辑",
      "nameEn": "Approved file writes and edits"
    },
    {
      "id": "files.instructions",
      "name": "工作区 AGENTS 指导文件加载",
      "nameEn": "Workspace AGENTS instruction loading"
    },
    {
      "id": "files.reference_metadata",
      "name": "无链接工作区引用元数据",
      "nameEn": "Workspace reference metadata without links"
    },
    {
      "id": "files.read_state_restore",
      "name": "恢复会话的文件读写快照",
      "nameEn": "Restored session file read and write snapshots"
    },
    {
      "id": "files.rewind_snapshots",
      "name": "授权文件修改前后快照",
      "nameEn": "Authorized file change snapshots"
    },
    {
      "id": "files.file_rewind",
      "name": "核验文件哈希后回退",
      "nameEn": "File rewind with after-hash verification"
    },
    {
      "id": "files.filesystem_adapter",
      "name": "工作区文件系统适配与版本写入",
      "nameEn": "Workspace filesystem adapter and revision writes"
    },
    {
      "id": "files.byte_ranges",
      "name": "有界文件字节范围读取",
      "nameEn": "Bounded file byte range reading"
    }
  ],
  "panels": [
    "files",
    "changes",
    "directory"
  ],
  "frontendModules": [
    "plugins/files/DirectoryBrowser.tsx",
    "plugins/files/FileBrowser.tsx",
    "plugins/files/DiffView.tsx"
  ],
  "modules": [
    "file_history",
    "file_rewind",
    "file_rewind_api",
    "file_bytes_api"
  ],
  "httpFamilies": [
    "sessions/*/file-bytes"
  ]
}
