{
  "apiVersion": 2,
  "id": "workflows",
  "name": "工作流与后台任务",
  "description": "持久化 DAG、恢复复用、并发控制和后台命令。",
  "version": "0.2.0",
  "defaultEnabled": true,
  "dependencies": [
    "sessions",
    "files",
    "shell"
  ],
  "provides": [
    "workflows.store"
  ],
  "inject": {
    "optional": [
      "workflows.agent"
    ]
  },
  "capabilities": {
    "exec": [
      "*"
    ],
    "fs": {
      "read": [
        "state",
        "workspace",
        "temp"
      ],
      "write": [
        "state",
        "workspace",
        "temp"
      ]
    }
  },
  "httpFamilies": [
    "workflows",
    "sessions/*/workflow-scripts"
  ],
  "tools": [
    {
      "name": "workflow_create",
      "gate": "planning",
      "mutating": false,
      "concurrencySafe": false
    },
    {
      "name": "workflow_amend",
      "gate": "planning",
      "mutating": false,
      "concurrencySafe": false
    },
    {
      "name": "workflow_run",
      "gate": "exec",
      "mutating": true,
      "concurrencySafe": false
    },
    {
      "name": "workflow_status",
      "gate": "planning",
      "mutating": false,
      "concurrencySafe": false
    },
    {
      "name": "background_exec",
      "gate": "exec",
      "mutating": true,
      "concurrencySafe": false
    },
    {
      "name": "background_status",
      "gate": "planning",
      "mutating": false,
      "concurrencySafe": false
    },
    {
      "name": "background_cancel",
      "gate": "exec",
      "mutating": true,
      "concurrencySafe": false
    },
    {
      "name": "background_logs",
      "gate": "planning",
      "mutating": false,
      "concurrencySafe": false
    },
    {
      "name": "workflow_answer_actor",
      "gate": "exec",
      "mutating": true,
      "concurrencySafe": false
    },
    {
      "name": "save_workflow",
      "gate": "planning",
      "mutating": false,
      "concurrencySafe": false
    },
    {
      "name": "list_saved_workflows",
      "gate": "planning",
      "mutating": false,
      "concurrencySafe": true
    },
    {
      "name": "run_saved_workflow",
      "gate": "exec",
      "mutating": true,
      "concurrencySafe": false
    },
    {
      "name": "workflow_script_create",
      "gate": "planning",
      "mutating": false,
      "concurrencySafe": false
    },
    {
      "name": "workflow_script_run",
      "gate": "exec",
      "mutating": true,
      "concurrencySafe": false
    },
    {
      "name": "workflow_script_status",
      "gate": "planning",
      "mutating": false,
      "concurrencySafe": false
    },
    {
      "name": "workflow_script_list",
      "gate": "planning",
      "mutating": false,
      "concurrencySafe": false
    },
    {
      "name": "workflow_script_cancel",
      "gate": "exec",
      "mutating": true,
      "concurrencySafe": false
    },
    {
      "name": "workflow_script_concurrency",
      "gate": "exec",
      "mutating": true,
      "concurrencySafe": false
    },
    {
      "name": "workflow_script_resolve",
      "gate": "exec",
      "mutating": true,
      "concurrencySafe": false
    },
    {
      "name": "workflow_script_amend",
      "gate": "planning",
      "mutating": false,
      "concurrencySafe": false
    }
  ],
  "commands": [
    "workflow",
    "workflows",
    "jobs",
    "expert",
    "workflow-script"
  ],
  "panels": [
    "workflows"
  ],
  "features": [
    {
      "id": "workflows.engine",
      "name": "DAG、声明式 DSL 与模型编排",
      "nameEn": "DAG, declarative DSL and model orchestration"
    },
    {
      "id": "workflows.actors",
      "name": "只读及已批准可写 actor 与问答",
      "nameEn": "Read-only and approved writable actors and questions"
    },
    {
      "id": "workflows.resume",
      "name": "持久恢复、结果复用与文件校验",
      "nameEn": "Persistent resume, result reuse and file checks"
    },
    {
      "id": "workflows.concurrency",
      "name": "动态并发、限流退避与跨运行调度",
      "nameEn": "Adaptive concurrency, rate backoff and scheduling"
    },
    {
      "id": "workflows.background",
      "name": "后台命令、日志、状态与取消",
      "nameEn": "Background commands, logs, status and cancellation"
    },
    {
      "id": "workflows.expert",
      "name": "专家工作流（调研、计划、实现、审查）",
      "nameEn": "Expert workflow (research, plan, implement, review)"
    },
    {
      "id": "workflows.dynamic_runs",
      "name": "按会话列出、取消与恢复动态工作流运行",
      "nameEn": "Per-session dynamic workflow run listing, cancellation and resume"
    },
    {
      "id": "workflows.saved_library",
      "name": "已保存工作流模板库（保存、列出、按名运行）",
      "nameEn": "Saved workflow template library (save, list, run by name)"
    },
    {
      "id": "workflows.typed_scripts",
      "name": "原生类型脚本、动态分支与并行",
      "nameEn": "Native typed scripts, dynamic branches and fan-out"
    },
    {
      "id": "workflows.script_journal",
      "name": "节点日志恢复、结果重用与修订",
      "nameEn": "Journaled script resume, result reuse and amendment"
    },
    {
      "id": "workflows.script_questions",
      "name": "脚本留白与 actor 问答恢复",
      "nameEn": "Script holes and actor question recovery"
    }
  ],
  "frontendModules": [
    "plugins/workflows/index.tsx",
    "plugins/workflows/ExpertPanel.tsx"
  ]
}
