    {
      "id": "sessions.compact_persistence",
      "name": "压缩操作持久化与中断恢复",
      "nameEn": "Durable compaction operations and recovery"
    },
    {
      "id": "sessions.headless",
      "name": "无头运行、恢复与机器输出",
      "nameEn": "Headless execution, resume and machine output"
