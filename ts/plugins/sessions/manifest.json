{
  "apiVersion": 2,
  "id": "sessions",
  "name": "会话管理",
  "description": "Durable session lifecycle, revision-bound conversations, queues and scoped private media.",
  "version": "0.2.0",
  "defaultEnabled": true,
  "capabilities": {
    "exec": [
      "ffmpeg",
      "powershell.exe",
      "pbcopy",
      "osascript",
      "wl-copy",
      "wl-paste",
      "xclip"
    ],
    "fs": {
      "read": [
        "state",
        "workspace"
      ],
      "write": [
        "state"
      ]
    }
  },
  "features": [
    {
      "id": "sessions.tui",
      "name": "全屏聊天、草稿与终端中断",
      "nameEn": "Fullscreen chat, drafts and terminal interruption"
    },
    {
      "id": "sessions.auto_title",
      "name": "自动命名会话",
      "nameEn": "Automatic conversation titles"
    },
    {
      "id": "sessions.runtime_model_switch",
      "name": "运行中切换模型与推理档位",
      "nameEn": "Switch model and reasoning effort between requests"
    },
    {
      "id": "sessions.manual_compact",
      "name": "手动压缩上下文",
      "nameEn": "Manual deterministic context compaction"
    },
    {
      "id": "sessions.lifecycle",
      "name": "会话创建、续行与停止",
      "nameEn": "Session creation continuation and stopping"
    },
    {
      "id": "sessions.management",
      "name": "会话标题、置顶与归档",
      "nameEn": "Session titles pins and archives"
    },
    {
      "id": "sessions.archived_delete",
      "name": "确认后永久删除归档",
      "nameEn": "Confirmed permanent archive deletion"
    },
    {
      "id": "sessions.portable",
      "name": "脱敏会话导入与导出",
      "nameEn": "Redacted session import and export"
    },
    {
      "id": "sessions.fork",
      "name": "安全历史边界分叉",
      "nameEn": "Forking at safe history boundaries"
    },
    {
      "id": "sessions.fork_from_checkpoint",
      "name": "从检查点前一轮分叉",
      "nameEn": "Forking before a checkpoint turn"
    },
    {
      "id": "sessions.scoped_commands",
      "name": "持久会话命令回执",
      "nameEn": "Durable session command acknowledgements"
    },
    {
      "id": "sessions.message_queue",
      "name": "持久消息队列与顺序执行",
      "nameEn": "Durable message queues and ordered execution"
    },
    {
      "id": "sessions.queue_withdrawal_recovery",
      "name": "队列撤回与文本恢复",
      "nameEn": "Queue withdrawals and text recovery"
    },
    {
      "id": "sessions.current_turn_guidance",
      "name": "当前轮次补充指导",
      "nameEn": "Guidance for the current turn"
    },
    {
      "id": "sessions.start_now",
      "name": "已排队消息立即发送",
      "nameEn": "Sending a queued message now"
    },
    {
      "id": "sessions.approvals",
      "name": "精确工具调用批准",
      "nameEn": "Approval for exact tool calls"
    },
    {
      "id": "sessions.message_edit",
      "name": "版本绑定的消息编辑",
      "nameEn": "Revision bound message editing"
    },
    {
      "id": "sessions.message_feedback",
      "name": "本地助手回答反馈",
      "nameEn": "Local assistant answer feedback"
